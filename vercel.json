{
  "crons": [{ "path": "/api/cron/purge", "schedule": "0 3 15 8 *" }],
  "rewrites": [
    { "source": "/a/:id", "destination": "/api/go?id=:id" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/|@|src/|node_modules/|__vite)[^.]*)", "destination": "/index.html" }
  ]
}
